# 生产环境变量模板。复制为 deploy/.env 并填入真实值（deploy/.env 不进 git）。
# 生成强随机值： openssl rand -hex 32

# ---- 站点 ----
SITE_DOMAIN=llmapi.example.com        # 你的域名（Caddy 用它签 HTTPS 证书）

# ---- 安全（务必强随机）----
ADMIN_KEY=
SESSION_SECRET=
CRYPTO_SECRET=
POSTGRES_PASSWORD=

# ---- 并发 ----
WEB_CONCURRENCY=2

# ---- 计费 ----
CREDITS_PER_USD=1000000
USD_CNY_RATE=7.2

# ---- 账户 / 登录 ----
ALLOW_REGISTRATION=true
# 邮箱密码注册/登录总开关。默认 false = 仅 OAuth 登录（推荐，无需邮件验证）。
# 设为 true 才开放邮箱注册；注意当前未接入邮箱验证，公开服务建议保持 false。
EMAIL_AUTH_ENABLED=false
SESSION_TTL_SECONDS=604800
DEFAULT_LANGUAGE=zh
# OAuth：redirect_uri 必须与 provider 后台登记的完全一致
OAUTH_PROVIDERS={}

# ---- 支付（可选）----
PAYMENT_PROVIDERS={}

# ---- 运营 ----
AUDIT_RETENTION_DAYS=90
METRICS_ENABLED=true
