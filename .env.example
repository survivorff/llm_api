# 复制为 .env 并填入真实值（.env 不会进 git）

# ---- 安全（上线前务必改成强随机值）----
ADMIN_KEY=admin-change-me
SESSION_SECRET=change-me-random-32
CRYPTO_SECRET=change-me-random-32byte-secret   # 用于加密存储上游 key

# ---- 服务 ----
HOST=127.0.0.1
PORT=8080

# ---- 数据库 ----
# 开发/单机默认 SQLite；生产改成 postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/llm_api.db

# ---- Redis（可选，多实例/高并发时启用；留空则用内存回退）----
# REDIS_URL=redis://localhost:6379/0

# ---- 计费 ----
CREDITS_PER_USD=1000000        # 1 USD = ? credits（内部整数计价单位）
USD_CNY_RATE=7.2               # 人民币→USD 换算

# ---- 账户 / 登录（v1.3）----
ALLOW_REGISTRATION=true
SESSION_TTL_SECONDS=604800     # 会话有效期（默认 7 天）
DEFAULT_LANGUAGE=zh            # 默认界面语言 zh/en
# OAuth 登录（JSON），示例：
# OAUTH_PROVIDERS={"github":{"client_id":"...","client_secret":"...","redirect_uri":"https://host/auth/oauth/github/callback"}}
OAUTH_PROVIDERS={}

# ---- 支付（v1.2，可选，JSON）----
# 易支付覆盖微信/支付宝；crypto 为 USDT-TRC20。示例见 docs/design/v1.2-PAYMENTS.md
# PAYMENT_PROVIDERS={"epay":{"api_url":"https://pay.x.com","pid":"1000","key":"xxx","notify_url":"https://host/pay/notify/epay"},"crypto":{"address":"TXXXX","api_key":"trongrid-key"}}
PAYMENT_PROVIDERS={}

# ---- 运营 / 可观测（v2.0）----
AUDIT_RETENTION_DAYS=90
METRICS_ENABLED=true

# ---- 首次启动从旧 config.yaml 导入渠道（可选）----
LEGACY_CONFIG_PATH=config.yaml

# ---- 上游 API key（供 config.yaml 首次导入用；导入后可在后台管理）----
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
