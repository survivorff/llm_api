# 复制为 .env 并填入真实值（.env 不会进 git）

# ---- 安全（上线前务必改成强随机值）----
ADMIN_KEY=admin-change-me
SESSION_SECRET=change-me-random-32
CRYPTO_SECRET=change-me-random-32byte-secret   # 用于加密存储上游 key

# ---- 服务 ----
HOST=127.0.0.1
PORT=8080

# ---- 数据库 ----
# 开发/单机默认 SQLite；生产改成 postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/llm_api.db

# ---- Redis（可选，多实例/高并发时启用；留空则用内存回退）----
# REDIS_URL=redis://localhost:6379/0

# ---- 首次启动从旧 config.yaml 导入渠道（可选）----
LEGACY_CONFIG_PATH=config.yaml

# ---- 上游 API key（供 config.yaml 首次导入用；导入后可在后台管理）----
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
